{
  "name": "@pdc/x402-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Internal adapter around @x402/* packages. Every PDC app talks to x402 through this module only — never import @x402/* directly elsewhere (CLAUDE.md P-stack rule, Section 17 and 18).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@x402/avm": "^2.19.0",
    "@x402/core": "^2.19.0",
    "@x402/hono": "^2.19.0"
  },
  "peerDependencies": {
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  }
}
