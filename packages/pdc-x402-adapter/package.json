{
  "name": "@pdc/x402-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Internal adapter around @x402/* packages and chain-verification libraries (viem, @solana/kit, algosdk). Every PDC app talks to payment chains through this module only — never import these directly elsewhere (CLAUDE.md P-stack rule, Section 17 and 18).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@x402/avm": "^2.30.0",
    "@x402/core": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/hono": "^2.30.0",
    "@solana/kit": "^8.6.0",
    "algosdk": "^3.9.0",
    "viem": "2.55.8"
  },
  "peerDependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  }
}
