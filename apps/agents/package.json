{
  "name": "@pdc/agents",
  "version": "0.1.0",
  "private": true,
  "description": "PDC first-party AI agent marketplace runtimes (CLAUDE.md Section 19, Session 7). Six agents (trade, climate, fisheries, agricultural, remittance, grants) that query PDC endpoints via x402 from an operational wallet and synthesise results with Claude.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "10.0.0-alpha.46",
    "@anthropic-ai/sdk": "^0.32.0",
    "@hono/node-server": "^1.14.0",
    "@pdc/shared-types": "workspace:*",
    "@pdc/x402-adapter": "workspace:*",
    "@supabase/supabase-js": "^2.47.0",
    "hono": "^4.12.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
