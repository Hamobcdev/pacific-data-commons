# Pacific Data Commons — Agent Marketplace Service (Session 7)
# Copy to .env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4023
PUBLIC_URL=http://localhost:4023
LOG_LEVEL=info

# Agent operational wallet — PAYS for PDC endpoint queries (R2/Model F).
# Shared across all six agents in this service. DIFFERENT from any provider
# payTo wallet, and different from apps/sbp-agent's own AGENT_WALLET_KEY —
# a separate wallet per running service keeps leaderboard attribution clean.
# Format: Base64-encoded 64-byte Algorand private key (32-byte seed +
# 32-byte public key) — same format @pdc/x402-adapter and
# apps/sbp-agent/.env.example already use.
AGENT_WALLET_KEY=
ALGORAND_NETWORK=mainnet
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud
# Session 13 — verifying a user's on-chain quote payment (execute route)
# needs a confirmed-transaction lookup by ID. Only the indexer keeps
# confirmed transactions permanently queryable; algod does not.
ALGORAND_INDEXER_URL=https://mainnet-idx.algonode.cloud

# PDC services this app queries.
DIRECTORY_API_URL=http://localhost:4020
PILOT_ENDPOINT_URL=http://localhost:4021

# Claude API for synthesis (CLAUDE.md Section 6 — Claude Sonnet 4.6 pinned).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Supabase — service-role key, used for seasonal_contexts reads only.
# Never exposed to a client; this is a backend-only service (same posture
# as apps/web's createServiceClient — see lib/supabase/server.ts there).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Rate limiting — per user wallet, not per IP (Deliverable 6).
MAX_REQUESTS_PER_MINUTE=10
# Session 13 — separate hourly windows for the user-facing quote/execute
# pair. A quote costs the agent's own wallet a real $0.01 directory search
# per required category, so quote spam has a real cost, not just compute.
MAX_QUOTES_PER_HOUR=20
MAX_EXECUTIONS_PER_HOUR=10

# Agent IDs — set after running `npx tsx scripts/register-agents.ts`
# against the target Supabase project. A route for an unset agent ID
# returns 503 rather than crashing the whole service at boot.
TRADE_AGENT_ID=
CLIMATE_AGENT_ID=
FISHERIES_AGENT_ID=
AGRICULTURAL_AGENT_ID=
REMITTANCE_AGENT_ID=
GRANTS_AGENT_ID=
