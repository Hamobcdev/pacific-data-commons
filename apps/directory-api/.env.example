# Pacific Data Commons — Directory API
# Copy to .env for local development. Never commit the real .env (CLAUDE.md P4:
# no secrets in code — all in environment variables).

NODE_ENV=development
PORT=8787

# Decision 2: Testnet for pipeline/API until explicitly flipped for the
# competition. Flipping this to "mainnet" is the only code change required.
ALGORAND_NETWORK=testnet

# SBP's own Algorand wallet — payTo for the $0.01 directory query fee
# (Decision 8 / Revenue Model Section 7). Must be USDC opted-in.
AVM_ADDRESS=

# x402 facilitator (CLAUDE.md Section 6 — GoPlausible; SPOF, handle failures gracefully)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Supabase — service role key only. This service bypasses RLS by design and
# enforces PDC-layer business rules (active/public/commercial filters) in the
# service layer instead. Never expose this key to a browser context.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Internal dashboard bypass — lets the SBP website (apps/web,
# synergybcpacific.com) fetch /finance/crypto-rates, /finance/fx,
# /finance/arbitrage-signals, and /finance/remittance-corridors without
# paying x402 on every request (middleware/dashboardBypass.ts). Sent as
# the X-Internal-Key header. Optional — unset means the bypass never
# activates and x402 is enforced as normal on every request (fail
# closed), not a boot failure. Must match apps/web's own
# DASHBOARD_INTERNAL_KEY value — separate services, separate env vars,
# same cross-service shared-secret pattern as apps/web's own
# INTERNAL_API_KEY/apps/directory-api's internalAuth.ts (see apps/web's
# .env.example).  # set in Vercel
DASHBOARD_INTERNAL_KEY=
