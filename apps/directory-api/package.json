{
  "name": "@pdc/directory-api",
  "version": "0.1.0",
  "private": true,
  "description": "Pacific Data Commons — Directory API (Component 1). x402-gated search and discovery over Pacific data providers/endpoints.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:cf": "wrangler deploy --config wrangler.toml",
    "dev:cf": "wrangler dev --config wrangler.toml",
    "build:cf": "tsc --noEmit && echo 'Types OK'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@hono/node-server": "^1.14.0",
    "@pdc/shared-types": "workspace:*",
    "@pdc/x402-adapter": "workspace:*",
    "@supabase/supabase-js": "^2.47.0",
    "@x402-avm/extensions": "^2.6.1",
    "hono": "^4.12.0",
    "resend": "^4.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
