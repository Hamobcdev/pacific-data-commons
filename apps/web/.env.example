# Pacific Data Commons — Web App (Provider Onboarding)
# Copy to .env.local for local development. Never commit real secrets.

# Supabase — both keys needed. Also used for file uploads (Session 10.1):
# NEXT_PUBLIC_SUPABASE_URL/ANON_KEY power the browser's direct resumable
# (TUS) upload to Supabase Storage — see lib/upload/chunked.ts. No separate
# storage credentials needed; Cloudflare R2 has been retired.
NEXT_PUBLIC_SUPABASE_URL=          # Public — safe for browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Public — safe for browser (RLS enforced)
SUPABASE_SERVICE_KEY=              # Private — server actions only, NEVER expose to the browser (R2)

# Algorand node — for wallet/USDC opt-in verification in server actions
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud

# Directory API URL — for buyer search (Session 7)
NEXT_PUBLIC_DIRECTORY_API_URL=     # e.g. https://pdc-directory.up.railway.app

# Agent service URL — required for the agent marketplace to function
# (apps/web/lib/agents/runner.ts). Points to the apps/agents Railway service
# (PORT 4023 locally — see apps/agents/.env.example). Without this set, every
# agent run fails with "AGENTS_SERVICE_URL is not configured" (Session 9 C2
# fix — this was previously undocumented here, which made the agent
# marketplace silently non-functional in every environment that copied only
# this file).
AGENTS_SERVICE_URL=                # e.g. https://pdc-agents.up.railway.app — confirm the
                                    # actual deployed domain in Railway (@pdc/agents service
                                    # -> Settings -> Networking -> Domain) before setting this
                                    # in Railway's @pdc/web service variables.

# Explicit operator gate for the interactive agent run flow (dry-run/quote/
# pay/execute) — see lib/agents/marketplaceStatus.ts. Defaults to disabled
# (shows an honest "actively being built" notice) unless set to the literal
# string "true". Only flip this on once AGENTS_SERVICE_URL is confirmed
# live and reachable — pdc-agents/pdc-sbp-agent are currently suspended on
# Render (free-tier usage limit).
NEXT_PUBLIC_AGENTS_MARKETPLACE_ENABLED=false

# Session 13 — user-pays-agent flow. The connected browser wallet (Pera or
# Lute) must target the same network the agents service pays PDC endpoints
# on (apps/agents/.env.example's ALGORAND_NETWORK) — a mismatch here would
# build a payment transaction for the wrong network's USDC asset, which the
# server-side verifier then correctly rejects as unverifiable.
NEXT_PUBLIC_ALGORAND_NETWORK=mainnet

# Session 23 (Decision 58) — SBP's collection address for the $25 USDC
# cold-inbound upload fee gate (components/upload/UploadPaymentGate.tsx).
# Public Algorand address — safe for the browser. Left unset here
# deliberately: the gate shows a "not yet configured" message rather than a
# fabricated address until this is actually set in Railway.
NEXT_PUBLIC_SBP_UPLOAD_FEE_WALLET=

# Stripe (Session 23, Deliverable 4) — "pay by card" for the upload fee
# gate, and deployment service fees (CLAUDE.md §7 Node Deployment Service
# table). Standard e-commerce, not a payment-intermediary function — no CBS
# consultation needed here, unlike anything in the x402/USDC path (P2).
# Use test-mode keys until this is actually launched.
STRIPE_SECRET_KEY=                        # Private — server only (lib/stripe.ts, app/api/stripe/*)
STRIPE_WEBHOOK_SECRET=                    # Private — from the Stripe dashboard's webhook endpoint config
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=       # Public — safe for browser (not yet used client-side; Checkout redirect only)

# Price IDs (create these Products/Prices in the Stripe dashboard first —
# see lib/stripe.ts's doc comment for the 5 products in CLAUDE.md §7's
# table). Reading amounts from Stripe rather than hardcoding them here
# keeps Stripe as the single source of truth for what's actually charged.
STRIPE_PRICE_UPLOAD_FEE=                  # $25 USD dataset upload fee
STRIPE_PRICE_SCANNED_PDF_SURCHARGE=       # +$10 USD scanned PDF surcharge
STRIPE_PRICE_DEPLOYMENT_STANDARD=         # $150 USD full SBP deployment
STRIPE_PRICE_DEPLOYMENT_COMPLEX=          # $300 USD complex deployment (cultural data, multiple datasets)

# Email (Session 37B — lib/email/resend.ts, apps/web's first Resend
# integration; deployment acknowledgement/SBP-notification/receipt emails
# for the deploy step). The OTP resume code email (Session 10) and any
# other Supabase Auth email is still sent via Supabase Auth's own SMTP
# configuration, set directly in the Supabase dashboard — unrelated to
# this. Optional: a missing key logs a warning and skips the send rather
# than throwing (same posture as apps/directory-api's own Resend usage).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pacificdatacommons.org

# Session 37B — SBP's PayTo Algorand wallet address, displayed in the
# deploy step's paid-tier payment instructions (components/deploy/AssistedCard.tsx)
# once ASSISTED_DEPLOYMENT_PRICE_USDC (lib/deploy/pricing.ts) is above 0.
# Public Algorand address — safe for the browser. Never hardcoded in
# source; left unset here deliberately, same "not yet configured" posture
# as NEXT_PUBLIC_SBP_UPLOAD_FEE_WALLET above.
NEXT_PUBLIC_SBP_PAYTO_ADDRESS=

# Session 37B — shared secret gating POST /api/invoices/confirm (SBP
# manually confirms a deployment payment and triggers the receipt email).
# Same X-Internal-Api-Key pattern as apps/directory-api's own
# INTERNAL_API_KEY/internalAuth.ts — a distinct value from that service's,
# since apps/web and apps/directory-api are separate Railway services with
# separate env vars.
INTERNAL_API_KEY=

# Session 39 — CBS Financial Rails oversight dashboard
# (/admin/financial-rails, apps/web/app/[locale]/(authenticated)/admin/financial-rails).
# FINANCIAL_RAILS_INTERNAL_URL must be the Railway *internal* URL of the
# @pdc/financial-rails service (that service has no public domain by
# design), not a public URL. FINANCIAL_RAILS_KEY must match the value set
# in @pdc/financial-rails' own environment (apps/financial-rails/.env.example)
# — sent as Authorization: Bearer <key>. Both are server-only; never
# exposed to the browser (lib/admin/financialRails.ts).
FINANCIAL_RAILS_INTERNAL_URL=      # e.g. http://financial-rails.railway.internal:8790
FINANCIAL_RAILS_KEY=

# Session 39 — gates /admin/financial-rails (lib/admin/access.ts). First
# code implementation of the ADMIN_EMAIL bypass CLAUDE.md §26.5 has
# documented since 2026-08-13 as a standing requirement. Set directly in
# Railway's @pdc/web service variables — never hardcoded or committed
# (CLAUDE.md P4). Unset means no session is ever treated as an admin
# session (fail-closed).
ADMIN_EMAIL=

# App
# NEXT_PUBLIC_APP_URL is used client- and server-side to build public
# listing URLs (components/complete/CompletionCard.tsx, the /data/[slug]
# page, dashboard/EndpointList.tsx). Session 10: the server-only APP_URL
# variable that used to exist here has been removed — it existed solely to
# build the magic-link resume email's redirect URL (lib/onboarding/resume.ts),
# which no longer applies now that resume uses a 6-digit OTP code with no
# redirect. Safe to delete from Railway's @pdc/web service variables once
# this ships.
NEXT_PUBLIC_APP_URL=               # e.g. https://app.pacificdatacommons.org

# Demo mode — bypasses domain/email verification for safe demonstrations.
# NEVER set to true in Railway production deployment (see lib/demo-mode.ts —
# NODE_ENV=production is an unconditional kill switch regardless of this).
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
