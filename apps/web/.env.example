# Pacific Data Commons — Web App (Provider Onboarding)
# Copy to .env.local for local development. Never commit real secrets.

# Supabase — both keys needed. Also used for file uploads (Session 10.1):
# NEXT_PUBLIC_SUPABASE_URL/ANON_KEY power the browser's direct resumable
# (TUS) upload to Supabase Storage — see lib/upload/chunked.ts. No separate
# storage credentials needed; Cloudflare R2 has been retired.
NEXT_PUBLIC_SUPABASE_URL=          # Public — safe for browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Public — safe for browser (RLS enforced)
SUPABASE_SERVICE_KEY=              # Private — server actions only, NEVER expose to the browser (R2)

# Algorand node — for wallet/USDC opt-in verification in server actions
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud

# Directory API URL — for buyer search (Session 7)
NEXT_PUBLIC_DIRECTORY_API_URL=     # e.g. https://pdc-directory.up.railway.app

# Agent service URL — required for the agent marketplace to function
# (apps/web/lib/agents/runner.ts). Points to the apps/agents Railway service
# (PORT 4023 locally — see apps/agents/.env.example). Without this set, every
# agent run fails with "AGENTS_SERVICE_URL is not configured" (Session 9 C2
# fix — this was previously undocumented here, which made the agent
# marketplace silently non-functional in every environment that copied only
# this file).
AGENTS_SERVICE_URL=                # e.g. https://pdc-agents.up.railway.app — confirm the
                                    # actual deployed domain in Railway (@pdc/agents service
                                    # -> Settings -> Networking -> Domain) before setting this
                                    # in Railway's @pdc/web service variables.

# Email — for magic link resume emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pacificdatacommons.org

# App
# APP_URL is the server-side app URL used for building redirect/resume links
# (e.g. lib/onboarding/resume.ts). Falls back to NEXT_PUBLIC_APP_URL if unset.
# Prefer setting APP_URL explicitly server-side; NEXT_PUBLIC_APP_URL remains
# for browser code that needs the app URL client-side.
APP_URL=                           # e.g. https://app.pacificdatacommons.org
NEXT_PUBLIC_APP_URL=               # e.g. https://app.pacificdatacommons.org

# Demo mode — bypasses domain/email verification for safe demonstrations.
# NEVER set to true in Railway production deployment (see lib/demo-mode.ts —
# NODE_ENV=production is an unconditional kill switch regardless of this).
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
