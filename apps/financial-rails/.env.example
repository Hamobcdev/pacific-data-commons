# Pacific Data Commons — CBS Financial Rails (Session 39)
# Copy to .env for local development. Never commit the real .env (CLAUDE.md P4:
# no secrets in code — all in environment variables).
#
# This service has NO public Railway domain (internal only) — see
# railway.json and index.ts's doc comment.

NODE_ENV=development
PORT=8790

# Supabase — service role key only. payment_providers, reserve_positions,
# and compliance_checks carry no anon/authenticated RLS policy at all
# (Session 38 migrations), so a service-role key is the only credential
# that can read them. Never expose this key to a browser context.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared secret gating every route except /health — sent as
# `Authorization: Bearer <FINANCIAL_RAILS_KEY>`. Generate with:
#   openssl rand -base64 32
# Must match the FINANCIAL_RAILS_KEY set in @pdc/web's environment
# (apps/web/.env.example) — apps/web's server-side dashboard data fetch is
# one of only two intended callers of this service.
FINANCIAL_RAILS_KEY=
