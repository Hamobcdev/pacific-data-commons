# Pacific Data Commons — Pilot Provider Endpoint
# Copy to .env for local development. Never commit the real .env (CLAUDE.md P4:
# no secrets in code — all in environment variables).

NODE_ENV=development

# Decision 2: Mainnet pilot endpoint from Phase 1 — this is the competition
# entry baseline, so it runs on Algorand Mainnet, not Testnet, from day one.
ALGORAND_NETWORK=mainnet

# Algorand Mainnet address that receives USDC payments for all 5 tiers.
# Must be opted in to USDC (ASA 31566704). This is SBP's demo wallet during
# the competition period — a real provider uses their own wallet.
AVM_ADDRESS=

# x402 facilitator (CLAUDE.md Section 6 — GoPlausible; SPOF, handle gracefully)
FACILITATOR_URL=https://facilitator.goplausible.xyz

PORT=4021
# Full public URL after deployment, e.g. https://pdc-pilot.up.railway.app —
# used to build the /integrity link embedded in every paid response.
PUBLIC_URL=http://localhost:4021

LOG_LEVEL=info

# Optional — logging paid transactions back to the PDC directory's Supabase
# is deferred; this endpoint runs standalone without it. Left here,
# unvalidated and unused by src/types/env.ts, so the wiring exists for
# whichever later session turns it on without another env-shape change.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DIRECTORY_ENDPOINT_ID=
