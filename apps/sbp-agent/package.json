{
  "name": "@pdc/sbp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "SBP's own scheduled agent — queries the PDC directory and pilot endpoint on an interval, dogfooding the platform and generating baseline x402-global-challenge leaderboard volume.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@hono/node-server": "^1.14.0",
    "@pdc/x402-adapter": "workspace:*",
    "hono": "^4.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
