# Pacific Data Commons — SBP Scheduled Query Agent
# Copy to .env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4022
LOG_LEVEL=info

# Directory API URL to query each cycle
DIRECTORY_URL=http://localhost:4020

# Decision 2 / same network the directory-api and pilot-endpoint are running on.
ALGORAND_NETWORK=mainnet
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud

# Agent wallet — makes real payments once set. Leave empty for dry-run mode
# (the agent logs what it would query/pay without spending anything).
#
# THIS MUST BE A DIFFERENT WALLET FROM AVM_ADDRESS (the payTo wallet used by
# apps/directory-api and apps/pilot-endpoint). AVM_ADDRESS RECEIVES payments;
# this wallet SPENDS them. Paying yourself from your own payTo wallet is a
# self-transaction GoPlausible would likely detect and exclude from the
# x402-global-challenge leaderboard — the whole point of this agent.
# Fund this wallet with a small amount of USDC + ~1 ALGO for fees.
#
# Format: Base64-encoded 64-byte Algorand private key (32-byte seed + 32-byte
# public key) — the same format @pdc/x402-adapter's createManualPaymentFetch
# expects, and the same TEST_PRIVATE_KEY format used by
# apps/pilot-endpoint/test/payment-client.ts.
#
# Session 8: this is now the AWS Secrets Manager fallback path only — see
# src/key-provider.ts. Leave it set for local dev without AWS credentials;
# in Railway/production, prefer AWS Secrets Manager below and leave this
# empty so the key never sits in plain environment config.
AGENT_WALLET_KEY=

# AWS Secrets Manager — preferred source for AGENT_WALLET_KEY in production
# (Session 8, Priority 1: the August 3 seed-phrase-in-env-var exposure that
# drove this). Leave all four empty for local dev; AGENT_WALLET_KEY above is
# used instead. When AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are both
# set, key-provider.ts fetches AGENT_WALLET_KEY fresh from Secrets Manager
# on every signing operation instead of reading it from process.env.
#
# The secret at AWS_SECRET_NAME must be a JSON blob: {"AGENT_WALLET_KEY": "<base64 key>"}
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SECRET_NAME=pdc/agent-wallet-key
AWS_REGION=ap-southeast-1

# How often to run a query cycle.
QUERY_INTERVAL_MINUTES=60
