# Pacific Data Commons — Root .env.example
#
# This is a reference index, not a file any process loads directly. Each app
# has its own .env.example with the variables it actually reads (see
# apps/*/env.ts / apps/*/types/env.ts) — copy the relevant section there.
# Variable names below match those real schemas exactly; a name that doesn't
# match what an app's env.ts validates is a bug, not a style choice, so this
# file intentionally does NOT invent app-prefixed aliases (DIRECTORY_PORT,
# PILOT_PORT, etc.) for values every app calls PORT — each app is deployed as
# its own Railway service with its own env scope, so there is no real PORT
# collision to avoid in production. Running more than one app locally at once
# just needs different PORT values in each app's own .env.
#
# Never commit real .env files — only .env.example.

# ── SHARED ACROSS APPS ───────────────────────────────────────────
# Same values, reused verbatim in the sections below. Not a separate config
# file — copy each into every app section that references it.

SUPABASE_URL=                     # https://[ref].supabase.co
SUPABASE_SERVICE_KEY=             # Service role key — server-side only, never in a browser

ALGORAND_NETWORK=mainnet          # Decision 2: mainnet from Phase 1. testnet also valid.
FACILITATOR_URL=https://facilitator.goplausible.xyz   # GoPlausible — SPOF, handle gracefully

# SBP's payTo wallet — RECEIVES payments (directory query fee, pilot endpoint
# tiers). Algorand Mainnet, opted in to USDC (ASA 31566704).
AVM_ADDRESS=

# ── apps/directory-api ────────────────────────────────────────────
# NODE_ENV=development
# PORT=8787
# ALGORAND_NETWORK=          (shared value above)
# AVM_ADDRESS=               (shared value above — directory query fee payTo)
# FACILITATOR_URL=           (shared value above)
# SUPABASE_URL=              (shared value above)
# SUPABASE_SERVICE_KEY=      (shared value above)

# ── apps/pilot-endpoint ───────────────────────────────────────────
# NODE_ENV=development
# PORT=4021
# ALGORAND_NETWORK=          (shared value above)
# AVM_ADDRESS=               (shared value above — pilot's own payTo; may be
#                             the same SBP demo wallet as directory-api, or a
#                             separate provider wallet for a real provider)
# FACILITATOR_URL=           (shared value above)
PILOT_PUBLIC_URL=                 # -> pilot-endpoint's own PUBLIC_URL
                                  # e.g. https://pdc-pilot.up.railway.app
                                  # Used to build the /integrity link embedded
                                  # in every paid response.

# ── apps/sbp-agent ────────────────────────────────────────────────
# NODE_ENV=development
# PORT=4022
# LOG_LEVEL=info
# ALGORAND_NETWORK=          (shared value above)
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud   # -> sbp-agent's ALGORAND_NODE_URL (USDC balance check)
DIRECTORY_URL=                    # -> sbp-agent's DIRECTORY_URL — the deployed directory-api's PUBLIC_URL

# SEPARATE wallet from AVM_ADDRESS above — see apps/sbp-agent/.env.example
# for why (AVM_ADDRESS receives, this wallet spends; using the same wallet
# for both is a self-payment GoPlausible would likely exclude from the
# leaderboard). Leave empty for dry-run mode.
AGENT_WALLET_KEY=
QUERY_INTERVAL_MINUTES=60

# ── scripts/seed-pilot.ts ─────────────────────────────────────────
# SUPABASE_URL=              (shared value above)
# SUPABASE_SERVICE_KEY=      (shared value above)
PILOT_ENDPOINT_URL=               # -> same value as PILOT_PUBLIC_URL above
# AVM_ADDRESS=               (shared value above — pilot's payTo, stored on
#                             the seeded provider record)
SBP_CONTACT_EMAIL=                # Contact email for the seeded provider record
