{
  "name": "pacific-data-commons",
  "private": true,
  "version": "0.1.0",
  "description": "Pacific Data Commons — sovereign data exchange infrastructure for the Pacific (x402/Algorand)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:directory-api": "pnpm --filter @pdc/x402-adapter build && pnpm --filter @pdc/directory-api dev",
    "dev:pilot-endpoint": "pnpm --filter @pdc/x402-adapter build && pnpm --filter @pdc/shared-types build && pnpm --filter @pdc/pilot-endpoint dev",
    "dev:sbp-agent": "pnpm --filter @pdc/x402-adapter build && pnpm --filter @pdc/sbp-agent dev",
    "dev:web": "pnpm --filter @pdc/shared-types build && pnpm --filter @pdc/web dev",
    "build:web": "pnpm --filter @pdc/shared-types build && pnpm --filter @pdc/web build",
    "seed-pilot": "pnpm --filter @pdc/scripts seed-pilot",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
